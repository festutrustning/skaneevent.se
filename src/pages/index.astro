---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FestLink from '../components/FestLink.astro';
import HomeHero from '../components/HomeHero.astro';
import FestReviews from '../components/FestReviews.astro';
import { SITE } from '../data/site';
import { offertEventUrlForPath } from '../data/festutrustning-links';
import { fetchFestReviews } from '../lib/festutrustning-sync';
import { buildServiceLd } from '../components/seo/serviceLd';
import { buildFaqLd, faqIdFromQuestion } from '../components/seo/faqLd';
import { buildAggregateRatingLd } from '../components/seo/aggregateRatingLd';
import '../styles/home.css';

const offertWhyHref = offertEventUrlForPath('/', 'home_why_cta');
const offertCloseHref = offertEventUrlForPath('/', 'cta_section');

const faqs = [
  {
    q: 'Vilken eventteknik behövs till ett företagsevent i Skåne?',
    a: 'Det beror på lokal, antal gäster och program. Vanligt är ljud, mikrofoner, ljus, scen och bild. Vi dimensionerar lösningen efter ert event och kan ha tekniker på plats.',
  },
  {
    q: 'Hur begär jag offert?',
    a: 'Fyll i formuläret på Begär offert. Beskriv datum, ort, typ av event och vad ni behöver hjälp med – vi återkommer med ett skräddarsytt förslag.',
  },
  {
    q: 'Levererar ni i hela Skåne?',
    a: 'Ja. Vi arbetar i hela Skåne län – Malmö, Lund, Helsingborg, Kristianstad, Landskrona och övriga orter.',
  },
  {
    q: 'Kan ni hjälpa till med rigg och tekniker?',
    a: 'Absolut. Vi erbjuder leverans, uppsättning, funktionskontroll och nedmontering. Tekniker kan finnas på plats under eventet vid behov.',
  },
  {
    q: 'Vilka typer av företagsevent hjälper ni till med?',
    a: 'Konferenser, produktlanseringar, galor, kick-offs, mässor, paneldiskussioner, julfester och företagsfester – med fokus på att tekniken fungerar hela vägen.',
  },
];

const services = [
  {
    href: '/ljud-ljus-foretagsevent/',
    title: 'Ljud',
    text: 'PA, mikrofoner och mixer för tal, panel och fest. Dimensionerat efter lokal och publik.',
  },
  {
    href: '/ljud-ljus-foretagsevent/',
    title: 'Ljus',
    text: 'Scenljus och uplights som följer programmet, från middag till dansgolv.',
  },
  {
    href: '/scen-till-event/',
    title: 'Scen',
    text: 'Modulscen och tross, byggd efter takhöjd, siktlinjer och antal talare.',
  },
  {
    href: '/eventteknik/',
    title: 'Bild',
    text: 'LED och projektion för presentation, produkt och varumärke.',
  },
];

const eventTypes = [
  { href: '/foretagsevent/', label: 'Företagsevent' },
  { href: '/konferens/', label: 'Konferens' },
  { href: '/gala/', label: 'Gala' },
  { href: '/produktlansering/', label: 'Produktlansering' },
  { href: '/foretagsfest/', label: 'Företagsfest' },
  { href: '/julfest/', label: 'Julfest' },
  { href: '/kickoff/', label: 'Kickoff' },
  { href: '/eventproduktion/', label: 'Eventproduktion' },
];

const featuredCaseIds = ['utomhus-led-scen-malmo', 'ljud-ljus-foretagsfest', 'tross-led-rigg'] as const;

const delivered: Record<(typeof featuredCaseIds)[number], string> = {
  'utomhus-led-scen-malmo': 'LED-scen, line array och tekniker utomhus.',
  'ljud-ljus-foretagsfest': 'PA, scenljus och mikrofoner från mingel till dansgolv.',
  'tross-led-rigg': 'Tross, hängd LED-skärm och scen i industrilokal.',
};

const allCases = await getCollection('cases');
const featuredCases = featuredCaseIds.flatMap((id) => {
  const entry = allCases.find((item) => item.id === id);
  return entry ? [{ entry, delivered: delivered[id] }] : [];
});

const cities = [
  { href: '/malmo/foretagsevent/', label: 'Malmö' },
  { href: '/lund/foretagsevent/', label: 'Lund' },
  { href: '/helsingborg/foretagsevent/', label: 'Helsingborg' },
];

const morePlaces = [
  { href: '/kristianstad/foretagsevent/', label: 'Kristianstad' },
  { href: '/landskrona/foretagsevent/', label: 'Landskrona' },
  { href: '/trelleborg/foretagsevent/', label: 'Trelleborg' },
  { href: '/ystad/foretagsevent/', label: 'Ystad' },
  { href: '/foretagsevent/', label: 'Hela Skåne' },
  { href: '/eventteknik/', label: 'Eventteknik' },
  { href: '/konferens/', label: 'Konferens' },
];

const guides = [
  {
    href: '/guider/checklista-foretagsevent/',
    title: 'Checklista för företagsevent',
    text: 'Det ni inte får glömma innan eventdagen.',
  },
  {
    href: '/guider/ljud-till-foretagsevent/',
    title: 'Vilket ljud behövs?',
    text: 'Dimensionera PA efter lokal och publik.',
  },
  {
    href: '/guider/teknik-till-konferens/',
    title: 'Teknik till konferens',
    text: 'Mikrofoner, bild och AV-checklista.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Förfrågan',
    text: 'Berätta datum, ort, antal gäster och vad som ska hända på scen.',
  },
  {
    n: '02',
    title: 'Förslag',
    text: 'Vi dimensionerar ljud, ljus, scen och bild efter lokal och program. Offerten kostar inget.',
  },
  {
    n: '03',
    title: 'Genomförande',
    text: 'Leverans, rigg, funktionskontroll och nedmontering. Tekniker på plats när det behövs.',
  },
];

const reviews = await fetchFestReviews(12);
const ratingLd = buildAggregateRatingLd(reviews);
const faqLd = buildFaqLd(faqs);

const jsonLd: Record<string, unknown>[] = [
  {
    ...buildServiceLd({
      name: 'Eventteknik för företagsevent i Skåne',
      description:
        'Professionell eventteknik och produktion för företagsevent: ljud, ljus, scen, bild, mikrofoner och tekniker.',
      canonicalPath: '/',
    }),
    '@id': 'https://skaneevent.se/#service',
    serviceType: 'Eventteknik och eventproduktion',
  },
];
if (faqLd) {
  jsonLd.push({ ...faqLd, '@id': 'https://skaneevent.se/#faq' });
}
if (ratingLd) jsonLd.push(ratingLd);
---

<BaseLayout
  title="Eventteknik och företagsevent i Skåne"
  description="Professionell eventteknik för företagsevent i Skåne. Ljud, ljus, scen, bild, mikrofoner och tekniker – en partner för hela eventet. Begär offert."
  canonicalPath="/"
  ogImage="/images/konferens-scen.jpg"
  jsonLd={jsonLd}
  cinematicHome
>
  <HomeHero />

  <section class="home-band reveal" aria-label="Skåne Event i siffror">
    <div class="container">
      <div class="home-split">
        <div>
          <h2>Skåne Event i siffror</h2>
          <p class="home-prose">
            Bas på {SITE.address.street} i {SITE.address.city}. Leverans och rigg i hela Skåne.
          </p>
        </div>
        <dl class="home-facts">
          <div>
            <dt>Genomförda event</dt>
            <dd>250+</dd>
          </div>
          <div>
            <dt>År i branschen</dt>
            <dd>4</dd>
          </div>
          <div>
            <dt>Svarstid</dt>
            <dd>24 h</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="home-band home-band-muted reveal" id="tjanster" aria-labelledby="tjanster-heading">
    <div class="container">
      <div class="home-split home-split-intro">
        <div>
          <p class="home-kicker">Tjänster</p>
          <h2 id="tjanster-heading">Ljud, ljus, scen och bild</h2>
        </div>
        <p class="home-prose">
          Presentationen ska höras, scenen ska synas och någon ska ta ansvar för helheten.
          Utrustningen levereras av <FestLink destination="home" context="home_why" anchorType="brand">Festutrustning.se</FestLink>.
        </p>
      </div>
      <div class="home-services">
        {services.map((service) => (
          <a class="home-service" href={service.href}>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <span class="home-more">Läs mer</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-band reveal" id="eventtyper" aria-labelledby="eventtyper-heading">
    <div class="container">
      <p class="home-kicker">Eventtyper</p>
      <h2 id="eventtyper-heading">Vilket event planerar ni?</h2>
      <ul class="home-types">
        {eventTypes.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-band home-band-ink reveal" id="case-teaser" aria-labelledby="case-heading">
    <div class="container">
      <div class="home-split home-split-intro">
        <div>
          <p class="home-kicker">Case</p>
          <h2 id="case-heading">Tre uppdrag i Skåne</h2>
        </div>
        <p class="home-prose">Egna bilder från genomförda event. Rubrik, ort och vad som levererades.</p>
      </div>
      <div class="home-cases">
        {featuredCases.map(({ entry, delivered: line }, index) => (
          <a class:list={['home-case', { 'home-case-lead': index === 0 }]} href={`/case/${entry.id}/`}>
            <img
              src={entry.data.image}
              alt={`${entry.data.eventType} i ${entry.data.location}`}
              width={index === 0 ? 768 : 768}
              height={1024}
              loading="lazy"
            />
            <div class="home-case-copy">
              <p class="home-kicker">{entry.data.location}{entry.data.guests ? ` · ${entry.data.guests}` : ''}</p>
              <h3>{entry.data.title}</h3>
              <p>{line}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="home-after"><a class="home-text-link" href="/case/">Se alla case</a></p>
    </div>
  </section>

  <section class="home-band reveal" aria-labelledby="steps-heading">
    <div class="container">
      <p class="home-kicker">Så går det till</p>
      <h2 id="steps-heading">Från förfrågan till genomfört event</h2>
      <ol class="home-steps">
        {steps.map((step) => (
          <li>
            <span class="home-step-n" aria-hidden="true">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <p class="home-after">
        <a class="home-btn home-btn-primary" href={offertWhyHref} data-fest-link data-link-context="home_why_cta" data-anchor-type="cta">Begär offert</a>
      </p>
    </div>
  </section>

  <FestReviews
    limit={3}
    title="Omdömen från genomförda uppdrag"
    lead="Hämtade från Festutrustning.se."
    reveal
  />

  <section class="home-band reveal" id="omraden" aria-labelledby="areas-heading">
    <div class="container">
      <p class="home-kicker">Område</p>
      <h2 id="areas-heading">Malmö, Lund, Helsingborg och övriga Skåne</h2>
      <div class="home-cities">
        {cities.map((city) => (
          <a href={city.href}>{city.label}</a>
        ))}
      </div>
      <ul class="home-places">
        {morePlaces.map((place) => (
          <li><a href={place.href}>{place.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-band home-band-muted reveal" id="guider-teaser" aria-labelledby="guider-heading">
    <div class="container">
      <p class="home-kicker">Guider</p>
      <h2 id="guider-heading">Innan ni begär offert</h2>
      <div class="home-guides">
        {guides.map((guide) => (
          <a href={guide.href}>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
          </a>
        ))}
      </div>
      <p class="home-after"><a class="home-text-link" href="/guider/">Alla guider</a></p>
    </div>
  </section>

  <section class="home-band reveal" id="faq" aria-labelledby="faq-heading">
    <div class="container home-faq">
      <p class="home-kicker">Vanliga frågor</p>
      <h2 id="faq-heading">FAQ – företagsevent &amp; eventteknik</h2>
      <div class="faq-list">
        {faqs.map((f, i) => (
          <details
            class="faq-item"
            data-faq-id={faqIdFromQuestion(f.q)}
            data-faq-question={f.q}
            open={i === 0}
          >
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="home-close reveal" aria-labelledby="cta-heading">
    <div class="container home-close-inner">
      <p class="home-kicker">Kontakt</p>
      <h2 id="cta-heading">Planerar ni ett event i Skåne?</h2>
      <p>Berätta om datum, ort och typ av event. Vi svarar inom 24 timmar.</p>
      <div class="home-actions">
        <a class="home-btn home-btn-primary" href={offertCloseHref} data-fest-link data-link-context="cta_section" data-anchor-type="cta">Begär offert</a>
        <a class="home-btn home-btn-ghost" href={`tel:${SITE.phone}`} data-link-context="landing_footer_phone">Ring {SITE.phoneDisplay}</a>
      </div>
    </div>
  </section>
</BaseLayout>
