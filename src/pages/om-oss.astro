---
import SolutionPage from '../components/SolutionPage.astro';
import OffertLink from '../components/OffertLink.astro';
import FestLink from '../components/FestLink.astro';
import PageShowcase from '../components/PageShowcase.astro';
import { SITE } from '../data/site';

const breadcrumbs = [{ name: 'Om oss', href: '/om-oss/' }];

const showcase = [
  { src: '/images/foretagsevent-dj.jpg', alt: 'DJ och ljus på företagsevent', caption: 'Företagsevent i praktiken' },
  { src: '/images/foretagsevent-led-rigg.jpg', alt: 'Omgivningsbelysning med LED-uplights inför företagsevent', caption: 'Omgivningsbelysning' },
  { src: '/images/eventproduktion.jpg', alt: 'Eventtekniker vid mixer och ljusbord', caption: 'Tekniker vid mixer' },
];
---

<SolutionPage
  title="Om Skåne Event"
  description="Skåne Event är specialistresursen för företagsevent och eventteknik i Skåne. Drivs av Festutrustning / Enta Sverige AB i Malmö."
  canonicalPath="/om-oss/"
  heroImage="/images/foretagsevent-dj.jpg"
  eyebrow="Om oss"
  h1="Om Skåne Event"
  lead="Vi planerar ljud, ljus, scen, bild och bemanning, levererar, riggar och plockar ner."
  breadcrumbs={breadcrumbs}
  ogImage="/images/foretagsevent-dj.jpg"
>
  <h2>Vi löser tekniken. Ni fokuserar på eventet</h2>
  <p>
    Skåne Event hjälper företag att planera och genomföra event med rätt teknik:
    ljud, ljus, scen, bild, mikrofoner och tekniker. Vi tar fram teknikplan, rigg och bemanning, och plockar ner efteråt.
    Ni behöver inte välja produkter ur en katalog.
    Hur ett uppdrag går till finns på <a href="/eventproduktion/">Så arbetar vi</a>.
  </p>
  <p>
    Verksamheten drivs av <strong>{SITE.orgName}</strong> (org.nr {SITE.orgNumber})
    via <FestLink destination="home" context="om_oss" anchorType="brand">Festutrustning.se</FestLink>,
    med bas på {SITE.address.street} i {SITE.address.city}.
  </p>

  <h2>Erfarenhet</h2>
  <p>Vi har erfarenhet av bland annat:</p>
  <ul>
    <li>Företagsevent och konferenser</li>
    <li>Galor och produktlanseringar</li>
    <li>Företagsfester, julfester och kickoffer</li>
    <li>Rigg av scen, tross, LED och ljud/ljus</li>
    <li>Tekniker på plats under genomförande</li>
  </ul>

  <h2>Hur vi arbetar med Festutrustning</h2>
  <p>
    Skåne Event tar emot förfrågan och tar fram förslaget.
    Festutrustning levererar utrustningen och genomförandet.
    <!-- TODO Rasmus: vem avtalar och fakturerar, hur ska Festutrustning nämnas -->
  </p>

  <p><OffertLink path="/om-oss/" context="om_oss_cta">Begär offert</OffertLink></p>

  <PageShowcase images={showcase} title="Event i Skåne" />
</SolutionPage>
