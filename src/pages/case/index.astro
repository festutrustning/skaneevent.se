---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import ImageBand from '../../components/ImageBand.astro';

const breadcrumbs = [{ name: 'Case', href: '/case/' }];

const bandImages = [
  { src: '/images/led-scen-utomhus.jpg', alt: 'LED-scen utomhus' },
  { src: '/images/rigg-eventteknik.jpg', alt: 'Rigg eventteknik' },
  { src: '/images/dj-ljudutrustning.jpg', alt: 'Ljud till företagsfest' },
];

const cases = (await getCollection('cases')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Case – företagsevent i Skåne"
  description="Se hur vi löst eventteknik till företagsevent i Skåne – utomhus LED-scen, konferens, gala och företagsfester."
  canonicalPath="/case/"
  breadcrumbs={breadcrumbs}
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1>Case</h1>
      <p class="page-lead">
        Exempel på hur vi hjälpt företag i Skåne med ljud, ljus, scen, bild och tekniker – från planering till genomförande.
      </p>
    </div>
  </div>

  <ImageBand images={bandImages} />

  <section class="section">
    <div class="container">
      <div class="card-grid card-grid-3">
        {cases.map((item) => (
          <a class="solution-card" href={`/case/${item.id}/`}>
            <img
              src={item.data.image}
              alt=""
              width="400"
              height="267"
              loading="lazy"
              style="margin-bottom: 1rem; border-radius: var(--radius); aspect-ratio: 3/2; object-fit: cover; width: 100%;"
            />
            <h3>{item.data.title}</h3>
            <p>{item.data.description}</p>
            <p class="guide-meta">{item.data.location} · {item.data.eventType}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTASection
    title="Vill ni ha liknande lösning?"
    text="Berätta om ert event – vi återkommer med ett skräddarsytt tekniskt förslag."
  />
</BaseLayout>
