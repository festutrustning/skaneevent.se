---
import { getCollection } from 'astro:content';
import SolutionPage from '../../components/SolutionPage.astro';
import CapacityOverview from '../../components/CapacityOverview.astro';

const breadcrumbs = [{ name: 'Case', href: '/case/' }];

const cases = (await getCollection('cases')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SolutionPage
  title="Case – företagsevent i Skåne"
  description="Se hur vi löst eventteknik till företagsevent i Skåne – utomhus LED-scen, konferens, gala och företagsfester."
  canonicalPath="/case/"
  heroImage="/images/case-hero.jpg"
  eyebrow="Case"
  h1="Case"
  lead="Exempel på ljud, bild, scen och personal vi redan satt in. Nästa uppdrag dimensioneras efter lokalen och programmet."
  breadcrumbs={breadcrumbs}
  wide
>
  <div class="section-header">
    <h2>Vad vi sätter in</h2>
    <p>Byggstenarna skalas efter lokal, publik och program. Gästantalet på korten gäller det uppdraget.</p>
  </div>
  <CapacityOverview />
  <div class="card-grid">
    {cases.map((item) => (
      <a class="solution-card case-card" href={`/case/${item.id}/`}>
        {item.data.image && (
          <img
            src={item.data.image}
            alt={item.data.imageAlt ?? ''}
            width="400"
            height="267"
            loading="lazy"
            style="margin-bottom: 1rem; border-radius: var(--radius); aspect-ratio: 3/2; object-fit: cover; width: 100%;"
          />
        )}
        <h3>{item.data.title}</h3>
        <p class="case-card-fact">{item.data.location} · {item.data.eventType}</p>
        <p>{item.data.kit}</p>
        <p>{item.data.crew}</p>
        {item.data.guests && <p class="case-card-fact">{item.data.guests} gäster på det här eventet</p>}
      </a>
    ))}
  </div>
</SolutionPage>
