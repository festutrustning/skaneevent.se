---
import { getCollection, render } from 'astro:content';
import SolutionPage from '../../components/SolutionPage.astro';
import { buildArticleLd } from '../../components/seo/articleLd';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  pubDate,
  location,
  eventType,
  guests,
  image,
  kit,
  crew,
  challenge,
  solution,
  result,
  seoTitle,
  seoDescription,
  ogImage,
  noindex,
} = entry.data;

const canonicalPath = `/case/${entry.id}/`;
const breadcrumbs = [
  { name: 'Case', href: '/case/' },
  { name: title, href: canonicalPath },
];

const pageTitle = seoTitle ?? title;
const pageDescription = seoDescription ?? description;
const pageOg = ogImage ?? image;

const jsonLd = buildArticleLd({
  title: pageTitle,
  description: pageDescription,
  canonicalPath,
  datePublished: pubDate,
  image: pageOg,
  aboutEvent: { name: title, location },
});
---

<SolutionPage
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  h1={title}
  lead={description}
  breadcrumbs={breadcrumbs}
  eyebrow="Case"
  heroImage={image}
  forceHero
  ogImage={pageOg}
  noIndex={noindex}
  extraJsonLd={jsonLd}
  footerCtaContext="case_footer_cta"
>
  <div class="case-article">
      <div class="case-meta">
        <span><strong>Plats:</strong> {location}</span>
        <span><strong>Eventtyp:</strong> {eventType}</span>
        {guests && <span><strong>Gäster:</strong> {guests} på det här eventet</span>}
        {kit && <span><strong>Teknik:</strong> {kit}</span>}
        {crew && <span><strong>Personal:</strong> {crew}</span>}
      </div>

      {challenge && (
        <Fragment>
          <h2>Utmaning</h2>
          <p>{challenge}</p>
        </Fragment>
      )}

      {solution && (
        <Fragment>
          <h2>Lösning</h2>
          <p>{solution}</p>
        </Fragment>
      )}

      {result && (
        <Fragment>
          <h2>Resultat</h2>
          <p>{result}</p>
        </Fragment>
      )}

      <div class="article-body">
        <Content />
      </div>
  </div>
</SolutionPage>
