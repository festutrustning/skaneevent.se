---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import ContentImage from '../../components/ContentImage.astro';
import { buildArticleLd } from '../../components/seo/articleLd';

const guideImages = [
  { src: '/images/konferens-scen.jpg', alt: 'Konferens och paneler', caption: 'Teknik som håller hela programmet' },
  { src: '/images/tross-uppsattning.jpg', alt: 'Tross och rigg', caption: 'Scen och rigg inför event' },
  { src: '/images/ljud-ljus-utrustning.jpg', alt: 'Ljud och ljus', caption: 'Ljud och ljus i praktiken' },
  { src: '/images/led-scen-utomhus.jpg', alt: 'LED utomhus', caption: 'LED och scen utomhus' },
  { src: '/images/eventproduktion.jpg', alt: 'Eventtekniker vid mixer och ljusbord', caption: 'Tekniker vid mixer och ljusbord' },
  { src: '/images/foretagsevent-dj.jpg', alt: 'DJ och ljus på företagsevent', caption: 'Företagsevent med ljud och ljus' },
];

export async function getStaticPaths() {
  const guides = await getCollection('guider');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  seoTitle,
  seoDescription,
  ogImage,
  noindex,
} = entry.data;

const canonicalPath = `/guider/${entry.id}/`;
const breadcrumbs = [
  { name: 'Guider', href: '/guider/' },
  { name: title, href: canonicalPath },
];

const heroImage = guideImages[entry.id.length % guideImages.length];
const pageTitle = seoTitle ?? title;
const pageDescription = seoDescription ?? description;
const pageOg = ogImage ?? heroImage.src;

const jsonLd = buildArticleLd({
  title: pageTitle,
  description: pageDescription,
  canonicalPath,
  datePublished: pubDate,
  dateModified: updatedDate,
  keywords: tags,
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  ogImage={pageOg}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  noIndex={noindex}
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      <p class="page-lead">{description}</p>
    </div>
  </div>

  <section class="section">
    <div class="container prose-page">
      <p class="guide-meta">
        Publicerad {pubDate.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}
        {updatedDate && (
          <> · Uppdaterad {updatedDate.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}</>
        )}
        {tags.length > 0 && <> · {tags.join(' · ')}</>}
      </p>
      <ContentImage {...heroImage} wide />
      <div class="article-body">
        <Content />
      </div>
    </div>
  </section>

  <CTASection sourcePath="/guider/" ctaContext="guide_footer_cta" />
</BaseLayout>
