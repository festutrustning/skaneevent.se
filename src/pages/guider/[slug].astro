---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import ContentImage from '../../components/ContentImage.astro';
import { SITE } from '../../data/site';

const guideImages = [
  { src: '/images/konferens-scen.jpg', alt: 'Konferens och paneler', caption: 'Teknik som håller hela programmet' },
  { src: '/images/tross-uppsattning.jpg', alt: 'Tross och rigg', caption: 'Scen och rigg inför event' },
  { src: '/images/ljud-ljus-utrustning.jpg', alt: 'Ljud och ljus', caption: 'Ljud och ljus i praktiken' },
  { src: '/images/led-scen-utomhus.jpg', alt: 'LED utomhus', caption: 'LED och scen utomhus' },
  { src: '/images/eventproduktion.jpg', alt: 'Eventproduktion', caption: 'Tekniker vid mixer och ljusbord' },
];

export async function getStaticPaths() {
  const guides = await getCollection('guider');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, tags } = entry.data;

const canonicalPath = `/guider/${entry.id}/`;
const breadcrumbs = [
  { name: 'Guider', href: '/guider/' },
  { name: title, href: canonicalPath },
];

const heroImage = guideImages[entry.id.length % guideImages.length];

const jsonLd = {
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@id': `${SITE.url}/#organization` },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: new URL(canonicalPath, SITE.url).href,
  inLanguage: 'sv-SE',
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{title}</h1>
      <p class="page-lead">{description}</p>
    </div>
  </div>

  <section class="section">
    <div class="container prose-page">
      <p class="guide-meta">
        Publicerad {pubDate.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}
        {updatedDate && (
          <> · Uppdaterad {updatedDate.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}</>
        )}
        {tags.length > 0 && <> · {tags.join(' · ')}</>}
      </p>
      <ContentImage {...heroImage} wide />
      <div class="article-body">
        <Content />
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
