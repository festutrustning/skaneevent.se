---
import { getCollection, render } from 'astro:content';
import SolutionPage from '../../components/SolutionPage.astro';
import { buildArticleLd } from '../../components/seo/articleLd';
import { getGuideImage } from '../../data/guide-images';

export async function getStaticPaths() {
  const guides = await getCollection('guider');
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  seoTitle,
  seoDescription,
  ogImage,
  noindex,
} = entry.data;

const canonicalPath = `/guider/${entry.id}/`;
const breadcrumbs = [
  { name: 'Guider', href: '/guider/' },
  { name: title, href: canonicalPath },
];

const heroImage = getGuideImage(entry.id);
const pageTitle = seoTitle ?? title;
const pageDescription = seoDescription ?? description;
const pageOg = ogImage ?? heroImage.src;

const jsonLd = buildArticleLd({
  title: pageTitle,
  description: pageDescription,
  canonicalPath,
  datePublished: pubDate,
  dateModified: updatedDate,
  keywords: tags,
});
---

<SolutionPage
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  h1={title}
  lead={description}
  breadcrumbs={breadcrumbs}
  eyebrow="Guider"
  heroImage={heroImage.src}
  forceHero
  ogImage={pageOg}
  noIndex={noindex}
  extraJsonLd={jsonLd}
  footerCtaContext="guide_footer_cta"
>
  <p class="guide-meta">
    Publicerad {pubDate.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}
    {updatedDate && (
      <> · Uppdaterad {updatedDate.toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })}</>
    )}
    {tags.length > 0 && <> · {tags.join(' · ')}</>}
  </p>
  <div class="article-body">
    <Content />
  </div>
</SolutionPage>
