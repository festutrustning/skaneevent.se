---
import { getCollection } from 'astro:content';
import SolutionPage from '../../components/SolutionPage.astro';
import { getGuideImage } from '../../data/guide-images';

const breadcrumbs = [{ name: 'Guider', href: '/guider/' }];

const guides = (await getCollection('guider')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SolutionPage
  title="Guider för företagsevent i Skåne"
  description="Praktiska guider om eventteknik, planering och genomförande av företagsevent i Skåne. Ljud, ljus, scen, konferens och mer."
  canonicalPath="/guider/"
  heroImage="/images/guider-hero.jpg"
  eyebrow="Guider"
  h1="Guider för företagsevent"
  lead="Lösningar och praktiska råd för dig som planerar företagsevent i Skåne – från checklistor och budget till ljud, ljus och tekniker på plats."
  breadcrumbs={breadcrumbs}
  wide
>
  <div class="card-grid">
    {guides.map((guide) => {
      const img = getGuideImage(guide.id);
      return (
        <a class="solution-card" href={`/guider/${guide.id}/`}>
          <img
            class="card-thumb"
            src={img.src}
            alt={img.alt}
            width="640"
            height="427"
            loading="lazy"
          />
          <h3>{guide.data.title}</h3>
          <p>{guide.data.description}</p>
          {guide.data.tags.length > 0 && (
            <p class="guide-meta">{guide.data.tags.join(' · ')}</p>
          )}
        </a>
      );
    })}
  </div>
</SolutionPage>
