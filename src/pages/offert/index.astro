---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../data/site';
import FestLink from '../../components/FestLink.astro';

const breadcrumbs = [{ name: 'Begär offert', href: '/offert/' }];
---

<BaseLayout
  title="Begär offert på eventteknik"
  description="Begär kostnadsfri offert på eventteknik till företagsevent i Skåne. Beskriv ert event så återkommer vi med ett skräddarsytt förslag."
  canonicalPath="/offert/"
  breadcrumbs={breadcrumbs}
>
  <div class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1>Begär offert</h1>
      <p class="page-lead">
        Berätta om ert event – vi återkommer med förslag på ljud, ljus, scen, bild och tekniker.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container" style="max-width: 40rem;">
      <form
        id="offert-form"
        class="form-grid"
        name="offert"
        data-lead-form
        data-intake-url={import.meta.env.PUBLIC_QUOTE_INTAKE_URL ?? ''}
      >
        <input type="hidden" name="form-name" value="offert" />
        <p class="hidden" style="display:none;">
          <label>Leave blank: <input name="bot-field" /></label>
        </p>

        <div class="form-grid form-grid-2">
          <div class="form-field">
            <label for="foretag">Företag *</label>
            <input id="foretag" name="foretag" type="text" required autocomplete="organization" />
          </div>
          <div class="form-field">
            <label for="kontaktperson">Kontaktperson *</label>
            <input id="kontaktperson" name="kontaktperson" type="text" required autocomplete="name" />
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-field">
            <label for="epost">E-post *</label>
            <input id="epost" name="epost" type="email" required autocomplete="email" />
          </div>
          <div class="form-field">
            <label for="telefon">Telefon *</label>
            <input id="telefon" name="telefon" type="tel" required autocomplete="tel" />
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-field">
            <label for="datum">Datum</label>
            <input id="datum" name="datum" type="date" />
          </div>
          <div class="form-field">
            <label for="ort">Ort *</label>
            <input id="ort" name="ort" type="text" required placeholder="t.ex. Malmö" />
          </div>
        </div>

        <div class="form-grid form-grid-2">
          <div class="form-field">
            <label for="eventtyp">Typ av event *</label>
            <select id="eventtyp" name="eventtyp" required>
              <option value="">Välj…</option>
              <option>Företagsevent</option>
              <option>Konferens</option>
              <option>Gala</option>
              <option>Produktlansering</option>
              <option>Företagsfest</option>
              <option>Julfest</option>
              <option>Kickoff</option>
              <option>Övrigt</option>
            </select>
          </div>
          <div class="form-field">
            <label for="gaster">Antal gäster</label>
            <input id="gaster" name="gaster" type="number" min="1" placeholder="t.ex. 120" />
          </div>
        </div>

        <div class="form-field">
          <label for="behov">Vad behövs hjälp med? *</label>
          <textarea id="behov" name="behov" required placeholder="Ljud, ljus, scen, LED, mikrofoner, tekniker…"></textarea>
        </div>

        <div class="form-field">
          <label for="budget">Budget/intervall (valfritt)</label>
          <input id="budget" name="budget" type="text" placeholder="om ni har en ram" />
        </div>

        <div class="form-field">
          <label for="meddelande">Övrig information</label>
          <textarea id="meddelande" name="meddelande"></textarea>
        </div>

        {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
          <div
            class="cf-turnstile"
            data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
          />
        )}
        <p id="offert-error" class="form-alert" hidden role="alert" tabindex="-1">
          Vi kunde inte skicka förfrågan just nu. Ring {SITE.phoneDisplay} så hjälper vi er, eller försök igen.
          <button type="button" class="btn btn-secondary" id="offert-retry">Försök igen</button>
        </p>
        <button type="submit" class="btn btn-primary btn-lg">Skicka offertförfrågan</button>
        <p class="form-note">
          Vi svarar inom 24 timmar.
          <!-- TODO Rasmus: bekräfta svarstid -->
          Genom att skicka godkänner ni vår <a href="/integritet/">integritetspolicy</a>.
          Ni kan också ringa <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
          eller se utrustning hos
          <FestLink destination="foretag" context="offert_form" anchorType="cta" utm campaign="offert">Festutrustning</FestLink>.
        </p>
      </form>
      <script is:inline>
        document.getElementById('offert-form')?.addEventListener('submit', (event) => {
          event.preventDefault();
          const form = event.currentTarget;
          if (!(form instanceof HTMLFormElement) || form.dataset.bound === '1') return;
          const error = document.getElementById('offert-error');
          if (!(error instanceof HTMLElement)) return;
          error.hidden = false;
          error.focus();
        });
      </script>
    </div>
  </section>
  {import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"></script>
  )}
</BaseLayout>
