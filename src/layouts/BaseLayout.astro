---
import { SITE, type BreadcrumbItem } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getPageSeo, normalizeSeoPath } from '../seo/pages-seo';
import { buildOrganizationGraph } from '../components/seo/organizationGraph';
import { buildBreadcrumbLd } from '../components/seo/breadcrumbLd';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  cinematicHome?: boolean;
}

const {
  title: propTitle,
  description: propDescription,
  canonicalPath,
  ogImage: propOgImage,
  breadcrumbs = [],
  jsonLd,
  noIndex: propNoIndex = false,
  cinematicHome = false,
} = Astro.props;

const registry = getPageSeo(normalizeSeoPath(canonicalPath));
const title = registry?.title ?? propTitle;
const description = registry?.description ?? propDescription;
const ogImage = propOgImage ?? registry?.ogImage ?? SITE.defaultOgImage;
const noIndex = propNoIndex || registry?.noindex === true;

const canonical = new URL(canonicalPath, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

const graph: Record<string, unknown>[] = [...buildOrganizationGraph()];
const breadcrumbLd = buildBreadcrumbLd(breadcrumbs);
if (breadcrumbLd) graph.push(breadcrumbLd);
if (jsonLd) {
  if (Array.isArray(jsonLd)) graph.push(...jsonLd);
  else graph.push(jsonLd);
}
---

<!DOCTYPE html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sv-se" href={canonical} />
    <meta name="theme-color" content="#7C3AED" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://festutrustning.se" />

    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        wait_for_update: 500
      });
      window.gtag = gtag;
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
    <script is:inline define:vars={{ gaId: SITE.gaId }}>
      gtag('js', new Date());
      gtag('config', gaId);
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />
  </head>
  <body class:list={{ 'page-home': cinematicHome }}>
    <a class="skip-link" href="#main">Hoppa till innehåll</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <script>
      import '../scripts/client.ts';
    </script>
  </body>
</html>
