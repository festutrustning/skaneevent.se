---
import type { PageImage } from '../data/page-images';

interface Props {
  images: PageImage[];
}

const { images } = Astro.props;
if (!images.length) return;
---

<div class="image-band" aria-hidden="true">
  {images.map((img) => (
    <div class="image-band-item">
      <img src={img.src} alt="" width="640" height="427" loading="lazy" />
    </div>
  ))}
</div>
