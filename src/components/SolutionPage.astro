---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CTASection from './CTASection.astro';
import ContentImage from './ContentImage.astro';
import FestBrandLogos from './FestBrandLogos.astro';
import PageShowcase from './PageShowcase.astro';
import { getPageVisuals } from '../data/page-images';
import type { BreadcrumbItem } from '../data/site';
import { offertEventUrlForPath } from '../data/festutrustning-links';
import { getPageSeo, normalizeSeoPath } from '../seo/pages-seo';
import { buildServiceLd } from './seo/serviceLd';
import { buildFaqLd, faqIdFromQuestion } from './seo/faqLd';
import { responsiveSources } from '../lib/responsive-image';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  h1: string;
  lead: string;
  breadcrumbs: BreadcrumbItem[];
  ogImage?: string;
  heroImage?: string;
  serviceName?: string;
  /** City for Service areaServed on geo landings. */
  areaServedName?: string;
  faqs?: { q: string; a: string }[];
  eyebrow?: string;
  /** Kortgallerier behöver hela kolumnen, inte läsbredden. */
  wide?: boolean;
  /** Visa hero-bilden även när den annars filtreras bort. */
  forceHero?: boolean;
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  footerCtaContext?: string;
}

const {
  title: propTitle,
  description: propDescription,
  canonicalPath,
  h1,
  lead,
  breadcrumbs,
  ogImage,
  heroImage,
  serviceName,
  areaServedName,
  faqs = [],
  eyebrow = 'Skåne Event',
  wide = false,
  forceHero = false,
  extraJsonLd,
  noIndex = false,
  footerCtaContext = 'landing_footer_cta',
} = Astro.props;

const seo = getPageSeo(normalizeSeoPath(canonicalPath));
const title = seo?.title ?? propTitle;
const description = seo?.description ?? propDescription;

const visuals = getPageVisuals(canonicalPath);
const offertCtaHref = offertEventUrlForPath(canonicalPath, 'landing_hero_cta');
const offertSidebarHref = offertEventUrlForPath(canonicalPath, 'landing_sidebar_cta');
const crowdHeroes = new Set([
  '/images/konferens-scen.jpg',
  '/images/konferens-publik.jpg',
  '/images/konferens-scen-960.jpg',
  '/images/scen-belysning.jpg',
  '/images/scen-publik.jpg',
  '/images/scenljus-publik.jpg',
  '/images/led-scen-hero.jpg',
  '/images/gala-foretagsevent.jpg',
  '/images/event-backstage.jpg',
  '/images/event-effekter.jpg',
  '/images/foretagsevent-atmosfar.jpg',
]);
const requestedHero = heroImage || ogImage || seo?.ogImage || '';
const heroPhoto =
  requestedHero && (forceHero || !crowdHeroes.has(requestedHero)) ? requestedHero : '';

const heroSet = heroPhoto ? responsiveSources(heroPhoto) : null;

const jsonLd: Record<string, unknown>[] = [];
if (serviceName) {
  jsonLd.push(
    buildServiceLd({ name: serviceName, description, canonicalPath, areaServedName }),
  );
}
const faqLd = buildFaqLd(faqs);
if (faqLd) jsonLd.push(faqLd);
if (extraJsonLd) {
  if (Array.isArray(extraJsonLd)) jsonLd.push(...extraJsonLd);
  else jsonLd.push(extraJsonLd);
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage || heroPhoto}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  noIndex={noIndex}
  darkHero
  heroPreload={heroSet ? { href: heroSet.preload, srcset: heroSet.avif } : undefined}
>
  <section class="landing-hero" aria-labelledby="landing-heading">
    {heroPhoto && (
      <div class="landing-hero-bg">
        {heroSet ? (
          <picture>
            <source type="image/avif" srcset={heroSet.avif} sizes="100vw" />
            <source type="image/webp" srcset={heroSet.webp} sizes="100vw" />
            <img src={heroPhoto} alt="" width="1400" height="933" fetchpriority="high" decoding="sync" />
          </picture>
        ) : (
          <img src={heroPhoto} alt="" width="1400" height="933" fetchpriority="high" />
        )}
      </div>
    )}
    <div class="landing-hero-shade" aria-hidden="true"></div>
    <div class="landing-cone" aria-hidden="true"></div>
    <div class="container landing-hero-content">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="landing-heading">{h1}</h1>
      <p class="landing-lead">{lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={offertCtaHref} data-fest-link data-link-context="landing_hero_cta" data-anchor-type="cta">Begär offert</a>
        <a class="btn btn-outline-white btn-lg" href="tel:+46766777232" data-link-context="landing_hero_phone">Ring oss</a>
      </div>
      <ul class="hero-trust" aria-label="Fördelar">
        <li>Leverans i hela Skåne</li>
        <li>Rigg &amp; tekniker</li>
        <li>Kostnadsfri offert</li>
      </ul>
    </div>
  </section>

  <section class="section landing-body">
    <div class="container landing-layout">
      <div class:list={['prose-page', 'landing-prose', { 'landing-prose-wide': wide }]}>
        {visuals?.feature && (
          <ContentImage
            src={visuals.feature.src}
            alt={visuals.feature.alt}
            caption={visuals.feature.caption}
            wide
          />
        )}
        <slot />
        {visuals?.gallery && visuals.gallery.length > 0 && (
          <PageShowcase images={visuals.gallery} title="Så kan tekniken se ut" />
        )}
      </div>

      <aside class="landing-sidebar">
        <div class="sidebar-card sidebar-cta">
          <h2>Planerar ni event?</h2>
          <p>Berätta om datum, ort och typ av event, så skickar vi ett förslag på teknik och pris. Offerten kostar inget.</p>
          <a class="btn btn-primary" href={offertSidebarHref} data-fest-link data-link-context="landing_sidebar_cta" data-anchor-type="cta">Begär offert</a>
          <a class="btn btn-secondary" href="tel:+46766777232" data-link-context="landing_sidebar_phone">076-677 72 32</a>
        </div>

        <div class="sidebar-card sidebar-links">
          <h2>Utforska mer</h2>
          <ul>
            <li><a href="/foretagsevent/">Företagsevent</a></li>
            <li><a href="/eventteknik/">Eventteknik</a></li>
            <li><a href="/guider/">Guider</a></li>
            <li><a href="/case/">Case</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section-alt" aria-labelledby="page-faq">
      <div class="container landing-faq">
        <div class="section-header">
          <p class="eyebrow">FAQ</p>
          <h2 id="page-faq">Vanliga frågor</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details
              class="faq-item"
              data-faq-id={faqIdFromQuestion(f.q)}
              data-faq-question={f.q}
              open={i === 0}
            >
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- TODO Rasmus: riktiga B2B-omdömen -->
  <FestBrandLogos />

  <CTASection sourcePath={canonicalPath} ctaContext={footerCtaContext} />
</BaseLayout>
