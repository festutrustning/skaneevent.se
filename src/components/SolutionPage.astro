---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CTASection from './CTASection.astro';
import ContentImage from './ContentImage.astro';
import FestLink from './FestLink.astro';
import PageShowcase from './PageShowcase.astro';
import { getPageVisuals } from '../data/page-images';
import type { BreadcrumbItem } from '../data/site';
import type { FestDestination } from '../data/festutrustning-links';
import {
  OFFERT_CTA_LABELS,
  offertEventUrlForPath,
} from '../data/festutrustning-links';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  h1: string;
  lead: string;
  breadcrumbs: BreadcrumbItem[];
  ogImage?: string;
  heroImage?: string;
  festLinks?: { destination: FestDestination; label: string; context: string }[];
  serviceName?: string;
  faqs?: { q: string; a: string }[];
  eyebrow?: string;
}

const {
  title,
  description,
  canonicalPath,
  h1,
  lead,
  breadcrumbs,
  ogImage,
  heroImage,
  festLinks = [],
  serviceName,
  faqs = [],
  eyebrow = 'Skåne Event',
} = Astro.props;

const heroSrc = heroImage || ogImage || '/images/konferens-scen.jpg';
const visuals = getPageVisuals(canonicalPath);
const offertCtaHref = offertEventUrlForPath(canonicalPath, 'landing_hero_cta');
const offertSidebarHref = offertEventUrlForPath(canonicalPath, 'landing_sidebar_cta');
const offertCtaLabel =
  OFFERT_CTA_LABELS[canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`] ??
  'Få förslag på eventlösning';

const jsonLd: Record<string, unknown>[] = [];
if (serviceName) {
  jsonLd.push({
    '@type': 'Service',
    name: serviceName,
    description,
    provider: { '@id': 'https://skaneevent.se/#organization' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Skåne län' },
    url: `https://skaneevent.se${canonicalPath}`,
  });
}
if (faqs.length) {
  jsonLd.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage || heroSrc}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <section class="landing-hero" aria-labelledby="landing-heading">
    <div class="landing-hero-bg" role="presentation">
      <img src={heroSrc} alt="" width="1400" height="933" fetchpriority="high" />
    </div>
    <div class="hero-spotlight" aria-hidden="true"></div>
    <div class="container landing-hero-content">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="landing-heading">{h1}</h1>
      <p class="landing-lead">{lead}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={offertCtaHref} data-fest-link data-link-context="landing_hero_cta" data-anchor-type="cta">{offertCtaLabel}</a>
        <a class="btn btn-outline-white btn-lg" href="tel:+46766777232">Ring 076-677 72 32</a>
      </div>
      <ul class="hero-trust" aria-label="Fördelar">
        <li>Leverans i hela Skåne</li>
        <li>Rigg &amp; tekniker</li>
        <li>Kostnadsfri offert</li>
      </ul>
    </div>
  </section>

  <section class="section landing-body">
    <div class="container landing-layout">
      <div class="prose-page landing-prose">
        {visuals?.feature && (
          <ContentImage
            src={visuals.feature.src}
            alt={visuals.feature.alt}
            caption={visuals.feature.caption}
            wide
          />
        )}
        <slot />
        {visuals?.gallery && visuals.gallery.length > 0 && (
          <PageShowcase images={visuals.gallery} title="Så kan tekniken se ut" />
        )}
      </div>

      <aside class="landing-sidebar">
        <div class="sidebar-card sidebar-cta">
          <h2>Planerar ni event?</h2>
          <p>Berätta om datum, ort och behov – vi återkommer med en teknisk lösning.</p>
          <a class="btn btn-primary" href={offertSidebarHref} data-fest-link data-link-context="landing_sidebar_cta" data-anchor-type="cta">{offertCtaLabel}</a>
          <a class="btn btn-secondary" href="tel:+46766777232">076-677 72 32</a>
        </div>

        {festLinks.length > 0 && (
          <div class="sidebar-card fest-aside">
            <h2>Teknikleverantör</h2>
            <p>När ni går från planering till utrustning och genomförande:</p>
            <ul>
              {festLinks.map((l) => (
                <li>
                  <FestLink
                    destination={l.destination}
                    context={l.context}
                    campaign={canonicalPath.replace(/\//g, '') || 'home'}
                    utm
                  >
                    {l.label}
                  </FestLink>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="sidebar-card sidebar-links">
          <h2>Utforska mer</h2>
          <ul>
            <li><a href="/foretagsevent/">Företagsevent</a></li>
            <li><a href="/eventteknik/">Eventteknik</a></li>
            <li><a href="/guider/">Guider</a></li>
            <li><a href="/case/">Case</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section-alt" aria-labelledby="page-faq">
      <div class="container landing-faq">
        <div class="section-header">
          <p class="eyebrow" style="color: var(--primary); background: var(--violet-50); border-color: var(--violet-200);">FAQ</p>
          <h2 id="page-faq">Vanliga frågor</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTASection />
</BaseLayout>
